<?xml version="1.0" encoding="utf-8"?>
<!-- شاشة الرنين: نص الذكر (تتلوّن كلماته بالأخضر عند نطقها)، شريط تقدّم، زر الميكروفون، وخيار الكتابة الاحتياطي -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ring_title"
            android:textColor="@color/green_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ring_hint"
            android:textColor="@color/beige_text"
            android:textSize="14sp" />

        <!-- بطاقة نص الذكر -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/beige_border"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/tvDhikr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.6"
                android:padding="22dp"
                android:textColor="@color/beige_text"
                android:textSize="23sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- شريط التقدّم -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/pbMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:indicatorColor="@color/green_primary"
            app:trackColor="@color/beige_light"
            app:trackCornerRadius="6dp"
            app:trackThickness="10dp" />

        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/green_dark"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:minHeight="44dp"
            android:text="@string/status_idle"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- زر النطق -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSpeak"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="8dp"
            android:text="@string/btn_speak"
            android:textSize="18sp"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />

        <!-- رابط الكتابة الاحتياطية -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTypeInstead"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_type_instead"
            android:textColor="@color/beige_text" />

        <!-- صندوق الكتابة (مخفي حتى يُطلب) -->
        <LinearLayout
            android:id="@+id/typeBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="none"
                android:background="@color/white"
                android:gravity="top|start"
                android:hint="@string/type_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="4"
                android:padding="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/beige_text"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerify"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_verify"
                app:cornerRadius="26dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
